{
  "manifest_version": 3,
  "name": "Sentinel — Website Trust & Privacy Guardian",
  "short_name": "Sentinel",
  "description": "Evidence-based website trust scoring, phishing warnings, tracker blocking, cookie inspection, and sensitive-form protection. Local-first.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sentinel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "cookies",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "analytics", "enabled": true, "path": "rules/analytics.json" },
      { "id": "advertising", "enabled": true, "path": "rules/advertising.json" },
      { "id": "social", "enabled": true, "path": "rules/social.json" },
      { "id": "session_replay", "enabled": true, "path": "rules/session_replay.json" },
      { "id": "fingerprinting", "enabled": false, "path": "rules/fingerprinting.json" },
      { "id": "strict", "enabled": false, "path": "rules/strict.json" }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  }
}
